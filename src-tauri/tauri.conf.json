{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mildify",
  "version": "0.3.0",
  "identifier": "dev.hackrxd.nativespotify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mildify",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' nsmod: http://nsmod.localhost; img-src 'self' data: blob: https: nsmod: http://nsmod.localhost; style-src 'self' 'unsafe-inline' nsmod: http://nsmod.localhost; font-src 'self' data: nsmod: http://nsmod.localhost; connect-src ipc: http://ipc.localhost https://*.scdn.co https://*.spotifycdn.com nsmod: http://nsmod.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1M0UyNzlCQ0NBQUU1MjIKUldRaTVhck1teWMraFZVZ0wvN3FxVVNydkdUWlBuN3Y4NGR6STJGZ2NYdkVYMHBFOHMwRnhOT2oK",
      "endpoints": ["https://github.com/hackrxd/mildify/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
